<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D14"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="30dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_card" android:gravity="center" android:text="⌁" android:textColor="#AFC0FF" android:textSize="24sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RemoteLink" android:textColor="#F5F8FD" android:textSize="27sp" android:textStyle="bold" />
                <TextView android:id="@+id/versionSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Controle Android pelo navegador" android:textColor="#7F8DA4" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/securityBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_status_banner" android:padding="14dp" android:text="LAN privada • QR/HMAC/SAS • WebRTC criptografado • uma sessão por vez" android:textColor="#E4C985" android:textSize="12sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACESSO LOCAL" android:textColor="#75849C" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="● Desligado" android:textColor="#97A3B6" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/sessionStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Nenhuma sessão ativa" android:textColor="#7F8DA4" android:textSize="12sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Endereço no Chromebook" android:textColor="#7B899E" android:textSize="11sp" />
            <TextView android:id="@+id/addressText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Endereço aparecerá aqui" android:textColor="#EAF0F8" android:textIsSelectable="true" android:textSize="15sp" android:textStyle="bold" />

            <Switch
                android:id="@+id/qrVisibilitySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mostrar QR de pareamento forte"
                android:textColor="#D2DBE7"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="QR de pareamento seguro"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView android:id="@+id/codeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_horizontal" android:letterSpacing="0.03" android:text="Código: —" android:textColor="#9FB2FF" android:textIsSelectable="true" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/serverButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_primary_button" android:text="Iniciar acesso local" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <Button android:id="@+id/newCodeButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:background="@drawable/bg_secondary_button" android:enabled="false" android:text="Gerar novo pareamento" android:textAllCaps="false" android:textColor="#E3E9F2" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PREPARAÇÃO" android:textColor="#75849C" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Permissões do Android" android:textColor="#F2F5FA" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/captureStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Autorize a tela e a Acessibilidade para controle completo" android:textColor="#94A0B2" android:textSize="12sp" />
            <Button android:id="@+id/captureButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:background="@drawable/bg_secondary_button" android:text="Autorizar tela inteira" android:textAllCaps="false" android:textColor="#E6ECF5" android:textSize="14sp" />
            <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_secondary_button" android:text="Ativar controle por Acessibilidade" android:textAllCaps="false" android:textColor="#E6ECF5" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/capabilitiesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERMISSÕES DA SESSÃO" android:textColor="#75849C" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Revogação em tempo real" android:textColor="#F2F5FA" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/capabilitiesStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Desmarcar uma capacidade a bloqueia imediatamente. Arquivos ainda exigem confirmação individual." android:textColor="#94A0B2" android:textSize="12sp" />

            <app.remotelink.ui.CapabilityCheckBox android:id="@+id/allowScreenCheck" android:tag="screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ver tela" android:textColor="#DDE5F1" android:textSize="14sp" />
            <app.remotelink.ui.CapabilityCheckBox android:id="@+id/allowTouchCheck" android:tag="touch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toque, arraste e navegação" android:textColor="#DDE5F1" android:textSize="14sp" />
            <app.remotelink.ui.CapabilityCheckBox android:id="@+id/allowKeyboardCheck" android:tag="keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Teclado remoto" android:textColor="#DDE5F1" android:textSize="14sp" />
            <app.remotelink.ui.CapabilityCheckBox android:id="@+id/allowFilesCheck" android:tag="files" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Receber arquivos" android:textColor="#DDE5F1" android:textSize="14sp" />

            <Button android:id="@+id/disconnectSessionButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary_button" android:enabled="false" android:text="Desconectar sessão atual" android:textAllCaps="false" android:textColor="#FFB9B9" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/updatePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATUALIZAÇÕES" android:textColor="#75849C" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/updateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="RemoteLink atualizado" android:textColor="#F2F5FA" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/updateStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Verificação segura por HTTPS + SHA‑256 + certificado de assinatura." android:textColor="#94A0B2" android:textSize="12sp" />
            <Button android:id="@+id/checkUpdateButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_secondary_button" android:text="Verificar atualização" android:textAllCaps="false" android:textColor="#E6ECF5" android:textSize="14sp" />
            <Switch android:id="@+id/autoUpdateSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Baixar atualizações automaticamente" android:textColor="#C8D1DF" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/footerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="LAN-only • sem UPnP • uma sessão por vez" android:textColor="#59667A" android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
